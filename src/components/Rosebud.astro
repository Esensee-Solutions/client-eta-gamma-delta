---
/* The Eta's flower: "un radiante capullo de rosa", chosen by the founders in 1928. Drawn here,
   not traced from anything of theirs. It takes the colour of currentColor for its lines and
   --bud for the petals. */
interface Props { class?: string; size?: number }
const { class: cls = '', size = 48 } = Astro.props;
---
<svg class={`rosebud ${cls}`} width={size} height={size * 1.5} viewBox="0 0 64 96" aria-hidden="true" focusable="false">
  <path class="stem" d="M32 46 C30.5 60 33.5 74 32 92" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
  <path class="leaf" d="M31.6 66 C24 58 15 58 10 64 C17 70 26 70 31.6 66 Z" />
  <path class="leaf" d="M32.4 76 C40 68 49 68 54 74 C47 80 38 80 32.4 76 Z" />
  <path class="vein" d="M30 65.5 C24 63.5 18 63.5 13 64.5 M34 75.5 C40 73.5 46 73.5 51 74.5" fill="none" stroke-width="1" />
  <path class="petal back" d="M32 8 C20 12 15 25 19 36 C22 45 42 45 45 36 C49 25 44 12 32 8 Z" />
  <path class="petal front" d="M32 15 C25 19 23 29 26 37 C28 42 36 42 38 37 C41 29 39 19 32 15 Z" />
  <path class="fold" d="M32 15 C29 22 29 31 32 40 M22 25 C27 23 33 26 37 33 M42 23 C38 25 35 29 34 35" fill="none" stroke-width="1.3" stroke-linecap="round" />
  <path class="sepal" d="M19 36 C15 44 20 49 27 46 C24 44 22 41 22 37 Z M45 36 C49 44 44 49 37 46 C40 44 42 41 42 37 Z" />
</svg>

<style>
  .rosebud { --bud: var(--gold-br, #e2c15a); --bud-dk: var(--gold, #c9a227); --leaf: #5c7a3a; color: var(--leaf); display: inline-block; }
  .petal.back { fill: var(--bud-dk); }
  .petal.front { fill: var(--bud); }
  .fold { stroke: rgb(0 0 0 / .28); }
  .leaf, .sepal { fill: var(--leaf); }
  .vein { stroke: rgb(255 255 255 / .35); }
  .rosebud.on-light { --leaf: #4f6b31; }
</style>
